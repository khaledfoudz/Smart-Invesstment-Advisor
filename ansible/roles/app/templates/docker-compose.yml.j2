# Generated by Ansible — do not edit manually on the server
# Source of truth: ansible/roles/app/templates/docker-compose.yml.j2

services:

  postgres:
    image: postgres:15-alpine
    container_name: smia-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB:       "{{ db_name }}"
      POSTGRES_USER:     "{{ db_user }}"
      POSTGRES_PASSWORD: "{{ db_password }}"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - smia-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user }} -d {{ db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    image: "{{ backend_image }}"
    container_name: smia-backend
    restart: unless-stopped
    ports:
      - "{{ backend_port }}:{{ backend_port }}"
    environment:
      NODE_ENV:        production
      PORT:            "{{ backend_port }}"
      DATABASE_URL:    "postgresql://{{ db_user }}:{{ db_password }}@postgres:5432/{{ db_name }}"
      JWT_SECRET:      "{{ jwt_secret }}"
      ML_SERVICE_URL:  "http://ml:{{ ml_port }}"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - smia-net
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:{{ backend_port }}/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5

  ml:
    image: "{{ ml_image }}"
    container_name: smia-ml
    restart: unless-stopped
    ports:
      - "{{ ml_port }}:{{ ml_port }}"
    environment:
      PORT: "{{ ml_port }}"
    networks:
      - smia-net
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:{{ ml_port }}/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5

  frontend:
    image: "{{ frontend_image }}"
    container_name: smia-frontend
    restart: unless-stopped
    ports:
      - "{{ frontend_port }}:80"
    depends_on:
      - backend
    networks:
      - smia-net

volumes:
  postgres_data:

networks:
  smia-net:
    driver: bridge